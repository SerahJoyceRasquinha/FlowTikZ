{
  "name": "flowchart-tikz-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Visual flowchart editor with real-time, Overleaf-ready LaTeX/TikZ generation, and import of images, SVG and draw.io diagrams as editable flowcharts.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "latex:fixtures": "node scripts/emit-fixtures.mjs",
    "serve": "node server/serve.mjs",
    "fixtures:import": "python3 scripts/make-import-fixtures.py"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
